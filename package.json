		"context",
		"usage",
		"git",
		"branch",
		"diff",
		"timer",
		"elapsed",
		"stats",
		"metrics",
		"telemetry",
		"monitoring",
		"streaming"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kslamph/pi-status-footer.git"
	},
	"files": [
		"stats-footer.ts",
		"README.md",
		"LICENSE"
	],
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
